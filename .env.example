# OpenAI-compatible endpoint configuration
SUN_API_KEY=sk-your-key-here
SUN_BASE_URL=https://api.openai.com/v1
SUN_MODEL=gpt-4o-mini

# Agent loop
SUN_MAX_TURNS=25
SUN_TEMPERATURE=0.0
# Optional. Empty = auto (gpt-5.3+ with tools → none). Override e.g. none/low/medium.
# SUN_REASONING_EFFORT=
SUN_MAX_RETRIES=4

# Tool execution
SUN_SHELL_TIMEOUT=60
SUN_MAX_OUTPUT_CHARS=8000

# Safety
SUN_REQUIRE_CONFIRMATION=true

# Durable memory (persona/rules/background). Default: ./long_memory.db next to .env
# On a new machine: copy .env + long_memory.db, then start local Redis for sessions.
# SUN_SQLITE_PATH=long_memory.db
# SUN_REDIS_URL=redis://127.0.0.1:6379/0

# Secret vault (https://mqeng.com) — login URLs / accounts. Token only in .env, never commit.
# SUN_SECRET_VAULT_URL=https://mqeng.com
# SUN_SECRET_VAULT_TOKEN=

# Browser automation (optional): uv sync --extra browser && uv run playwright install chromium
# SUN_BROWSER_ENABLED=true
# SUN_BROWSER_HEADLESS=false
# SUN_BROWSER_TIMEOUT_MS=30000
# SUN_BROWSER_SCREENSHOT_DIR=

# Vision model for analyze_image / browser_screenshot(analyze=true). Empty = SUN_MODEL.
# SUN_VISION_MODEL=glm-4.6v
